          "primary": false,
          "expression": "CREATE UNIQUE INDEX wager_processed_reversal_unique ON public.wager_transactions USING btree (reference_transaction_id, kind) WHERE ((reference_transaction_id IS NOT NULL) AND ((kind)::text = ANY ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) AND ((status)::text = 'PROCESSED'::text))"
